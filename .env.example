# ==============================================================================
# GAMER PERÚ — Canonical Environment Contract
# Copy this file to .env.local for local development.
# ZERO production secrets should be committed or placed here.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC / BROWSER-SAFE CONFIGURATION (NEXT_PUBLIC_*)
# ------------------------------------------------------------------------------
# Canonical application base URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Edge CDN public media delivery URL (media.gamerperu.com in prod)
NEXT_PUBLIC_CDN_URL=http://localhost:3000/media

# Supabase Auth URL (local Supabase CLI instance: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase Publishable Key (sb_publishable_..., safe for browser exposure)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder_key

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY CONFIGURATION (Never exposed to client bundles)
# ------------------------------------------------------------------------------
# Node runtime environment
NODE_ENV=development

# Application Runtime PostgreSQL Connection String
# Local development default: postgres://postgres:postgres@127.0.0.1:54322/postgres
# Remote Supabase Runtime (Supavisor Transaction Pooler, Port 6543, prepare: false):
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# Migration & Admin Tooling PostgreSQL Connection String (Server-only / Drizzle CLI)
# Local development default: postgres://postgres:postgres@127.0.0.1:54322/postgres
# Remote Supabase Preferred (Direct connection, Port 5432):
# DATABASE_MIGRATION_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require
# Remote Supabase Fallback (Supavisor Session Pooler for IPv4, Port 5432):
# DATABASE_MIGRATION_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_MIGRATION_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# Resend API Key (for transactional commerce emails via Inngest)
RESEND_API_KEY=re_placeholder_api_key

# Cloudflare R2 Object Storage Credentials (Server-only S3-compatible API)
R2_ACCOUNT_ID=placeholder_r2_account_id
R2_ACCESS_KEY_ID=placeholder_r2_access_key_id
R2_SECRET_ACCESS_KEY=placeholder_r2_secret_access_key
R2_PUBLIC_MEDIA_BUCKET=gamerperu-public-media
R2_PRIVATE_PROOFS_BUCKET=gamerperu-private-proofs
R2_DB_BACKUPS_BUCKET=gamerperu-db-backups-private

# Inngest Server Configuration (local dev runs without cloud keys)
INNGEST_EVENT_KEY=placeholder_inngest_event_key
INNGEST_SIGNING_KEY=placeholder_inngest_signing_key

# ------------------------------------------------------------------------------
# 3. MASTER APPLICATION SECRETS (Server-only runtime master key)
# ------------------------------------------------------------------------------
# 256-bit hexadecimal key used for encrypting external AI provider keys at rest
AI_ENCRYPTION_KEY_V1=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# 4. OPTIONAL SENTRY OBSERVABILITY
# ------------------------------------------------------------------------------
# Public DSN for error reporting
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Build-time source map upload credentials (optional)
# SENTRY_AUTH_TOKEN=sntrys_placeholder_token
# SENTRY_ORG=gamer-peru
# SENTRY_PROJECT=gamer-peru-storefront
