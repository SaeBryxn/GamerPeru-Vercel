# ==============================================================================
# GAMER PERÚ — Canonical Environment Contract
# Copy this file to .env.local for local development.
# ZERO production secrets should be committed or placed here.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC / BROWSER-SAFE CONFIGURATION (NEXT_PUBLIC_*)
# ------------------------------------------------------------------------------
# Canonical application base URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Edge CDN public media delivery URL (media.gamerperu.com in prod)
NEXT_PUBLIC_CDN_URL=http://localhost:3000/media

# Supabase Auth URL (local Supabase CLI instance: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase Publishable Key (sb_publishable_..., safe for browser exposure)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder_key

# Store WhatsApp for the PDP "Contactar por WhatsApp" button: international
# format, digits only (e.g. 51987654321). Leave empty to hide it in production.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY CONFIGURATION (Never exposed to client bundles)
# ------------------------------------------------------------------------------
# Node runtime environment
NODE_ENV=development

# Local-only synthetic catalog preview. Never enable in production.
DEV_CATALOG_PREVIEW=0

# Application Runtime PostgreSQL Connection String
# Local development default: postgres://postgres:postgres@127.0.0.1:54322/postgres
# Remote Supabase Runtime (Supavisor Transaction Pooler, Port 6543, prepare: false):
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# Migration & Admin Tooling PostgreSQL Connection String (Server-only / Drizzle CLI)
# Local development default: postgres://postgres:postgres@127.0.0.1:54322/postgres
# Remote Supabase Preferred (Direct connection, Port 5432):
# DATABASE_MIGRATION_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require
# Remote Supabase Fallback (Supavisor Session Pooler for IPv4, Port 5432):
# DATABASE_MIGRATION_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_MIGRATION_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# Resend API Key (for transactional commerce emails via Inngest)
RESEND_API_KEY=re_placeholder_api_key

# Cloudflare R2 Object Storage Credentials (Server-only S3-compatible API)
R2_ACCOUNT_ID=placeholder_r2_account_id
R2_ACCESS_KEY_ID=placeholder_r2_access_key_id
R2_SECRET_ACCESS_KEY=placeholder_r2_secret_access_key
R2_PUBLIC_MEDIA_BUCKET=gamerperu-public-media
R2_CATALOG_STAGING_BUCKET=gamerperu-catalog-staging-private
R2_PRIVATE_PROOFS_BUCKET=gamerperu-private-proofs
R2_DB_BACKUPS_BUCKET=gamerperu-db-backups-private

# Inngest Server Configuration (local dev runs without cloud keys)
INNGEST_EVENT_KEY=placeholder_inngest_event_key
INNGEST_SIGNING_KEY=placeholder_inngest_signing_key

# GP-025 research acquisition (server-only)
TAVILY_API_KEY=placeholder_tavily_api_key
AI_RESEARCH_FETCH_USER_AGENT=GamerPeruResearchBot/1.0 (+https://gamerperu.com; operations-contact=replace_with_real_contact)

# ------------------------------------------------------------------------------
# 3. MASTER APPLICATION SECRETS (Server-only runtime master key)
# ------------------------------------------------------------------------------
# 256-bit hexadecimal key used for encrypting external AI provider keys at rest
AI_ENCRYPTION_ACTIVE_KEY_VERSION=1
AI_ENCRYPTION_KEY_V1=replace_with_real_64_hex_secret

# ------------------------------------------------------------------------------
# 5. CHECKOUT RUNTIME CONFIGURATION (Server-only)
# ------------------------------------------------------------------------------
# Server-only HMAC secret for authority binding and request fingerprinting (minimum 32 characters)
CHECKOUT_HMAC_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Primary inventory warehouse location code for checkout reservation fulfillment
CHECKOUT_PRIMARY_INVENTORY_LOCATION_CODE=LOC-LIM-01

# Reservation TTL in minutes before stock holds expire (e.g. 30 minutes)
CHECKOUT_RESERVATION_TTL_MINUTES=30

# Idempotency key TTL in minutes for duplicate submission replays (e.g. 60 minutes)
CHECKOUT_IDEMPOTENCY_TTL_MINUTES=60

# ------------------------------------------------------------------------------
# 6. PAYMENT RUNTIME CONFIGURATION (Server-only)
# ------------------------------------------------------------------------------
# Idempotency key TTL in minutes for manual payment submission replays (e.g. 60 minutes)
# Production configuration / TBD. Must be a positive bounded integer (1-10080).
PAYMENT_SUBMISSION_IDEMPOTENCY_TTL_MINUTES=60

# Hours a customer has to resubmit after a retryable rejection (e.g. illegible voucher).
# Optional; defaults to 24. Integer between 1 and 168.
PAYMENT_RESUBMISSION_GRACE_HOURS=24

# ------------------------------------------------------------------------------
# 7. ORDER MANAGEMENT RUNTIME CONFIGURATION (Server-only)
# ------------------------------------------------------------------------------
# Idempotency key TTL in minutes for order cancellation and refund replays (e.g. 60 minutes)
# Production configuration / TBD. Must be a positive bounded integer (1-10080).
ORDER_MANAGEMENT_IDEMPOTENCY_TTL_MINUTES=60

# ------------------------------------------------------------------------------
# 8. INVENTORY ENGINE RUNTIME CONFIGURATION (Server-only, GP-021)
# ------------------------------------------------------------------------------
# Server-only HMAC secret for inventory authority binding digests (minimum 32 characters)
INVENTORY_HMAC_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Idempotency key TTL in minutes for inventory mutations (e.g. 1440 minutes / 24 hours)
INVENTORY_IDEMPOTENCY_TTL_MINUTES=1440

# Optional default quarantine inventory warehouse location code
INVENTORY_QUARANTINE_LOCATION_CODE=LOC-LIM-QUARANTINE

# ------------------------------------------------------------------------------
# 9. CATALOG MEDIA RUNTIME CONFIGURATION (Server-only, GP-024)
# ------------------------------------------------------------------------------
# Server-only 256-bit hexadecimal HMAC secret for catalog media upload intent signing.
# Production configuration: exactly 64 hexadecimal characters representing 32 bytes.
# Direct browser upload to R2 staging additionally requires the private staging bucket
# and appropriate Cloudflare CORS configuration allowing the origin and required PUT headers.
CATALOG_MEDIA_INTENT_HMAC_SECRET=replace-with-64-character-hexadecimal-hmac-secret-min-32-bytes-long
