diff --git a/cf/src/connection.js b/cf/src/connection.js
index 8e79170aeb13efe8c3c77ccede0cd3a115b5e1b5..afb98d384d93dc30fa3bb1f5b73672171a277859 100644
--- a/cf/src/connection.js
+++ b/cf/src/connection.js
@@ -172,11 +172,17 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
         : (query = q, query.active = true)
 
       build(q)
-      return write(toBuffer(q))
+      const canPipeline = write(toBuffer(q))
         && !q.describeFirst
         && !q.cursorFn
         && sent.length < max_pipeline
-        && (!q.options.onexecute || q.options.onexecute(connection))
+      // sql.begin must reserve its connection even when pipelining is off (max_pipeline: 0);
+      // upstream only reserved it when the connection could take another query.
+      if (q.options.onexecute) {
+        q.options.onexecute(connection)
+        return false
+      }
+      return canPipeline
     } catch (error) {
       sent.length === 0 && write(Sync)
       errored(error)
