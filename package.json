{
  "name": "gamerperu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.22.0 <12"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cart:live": "vitest run --config vitest.integration.config.ts",
    "test:checkout:live": "vitest run --config vitest.checkout.integration.config.ts",
    "test:payment:live": "vitest run --config vitest.payment.integration.config.ts",
    "test:order:live": "vitest run --config vitest.order.integration.config.ts",
    "test:inventory:live": "vitest run --config vitest.inventory.integration.config.ts",
    "test:admin:live": "vitest run --config vitest.admin.integration.config.ts",
    "test:notifications:live": "vitest run --config vitest.notifications.integration.config.ts",
    "test:cart:e2e": "playwright test --config=playwright.cart.config.ts",
    "test:checkout:e2e": "playwright test --config=playwright.checkout.config.ts",
    "test:payment:e2e": "playwright test --config=playwright.payment.config.ts",
    "test:admin:e2e": "playwright test --config=playwright.admin.config.ts",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "supabase": "supabase",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "docs:screenshots": "node scripts/docs/capture-screenshots.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1111.0",
    "@aws-sdk/s3-request-presigner": "3.1111.0",
    "@google/genai": "2.22.0",
    "@sentry/nextjs": "10.70.0",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "aws4fetch": "1.0.20",
    "drizzle-orm": "0.45.2",
    "framer-motion": "13.4.0",
    "htmlparser2": "12.0.0",
    "inngest": "4.18.1",
    "lucide-react": "1.31.0",
    "next": "16.3.6",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@next/eslint-plugin-next": "16.3.6",
    "@opennextjs/cloudflare": "1.20.7",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "jsdom": "^30.0.1",
    "prettier": "3.9.6",
    "sharp": "0.35.4",
    "supabase": "2.114.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "wrangler": "4.143.0"
  }
}
